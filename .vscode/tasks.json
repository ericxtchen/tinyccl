{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build CUDA (clang)",
      "type": "shell",
      "command": "clang++",
      "args": [
        "-std=c++20", "--cuda-gpu-arch=sm_89",
        "-L/usr/local/cuda/lib64", "-lcudart_static", "-ldl", "-lrt", "-pthread",
        "${file}", "-o", "${fileDirname}/${fileBasenameNoExtension}"
      ],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    }
  ]
}